# Copier ce fichier en `.env` (jamais committé) : cp .env.example .env
# Valeurs ci-dessous = defaults de dev local, sans valeur réelle sensible.

# --- Postgres (service `postgres` du docker-compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Backend (api, worker) ---
# Doit rester cohérent avec POSTGRES_USER/PASSWORD/DB ci-dessus.
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app  # pragma: allowlist secret

# Clé de signature JWT. En dev, une valeur aléatoire locale suffit.
# En prod : jamais ici, gérée par Secret Manager (agents.md §7).
JWT_SIGNING_KEY=dev-secret-change-me

# Clé API du fournisseur LLM choisi (EPIC E). Laisser vide tant que
# l'intégration LLM n'est pas branchée.
LLM_API_KEY=

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# URL de l'API telle qu'accessible depuis le navigateur (pas le nom
# de service docker "api", qui n'est résolvable qu'entre containers).
NEXT_PUBLIC_API_URL=http://localhost:8000
