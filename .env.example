# Copier ce fichier en `.env` (jamais committé) : cp .env.example .env
# Valeurs ci-dessous = defaults de dev local, sans valeur réelle sensible.

# --- Postgres (service `postgres` du docker-compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Backend (api, worker) ---
# Doit rester cohérent avec POSTGRES_USER/PASSWORD/DB ci-dessus.
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app  # pragma: allowlist secret

# Pool de connexions borné (agents.md §2/§3, projets.md) : Cloud Run
# scale-to-zero peut redémarrer plusieurs instances d'un coup, chacune
# ouvrant son propre pool. Optionnelles : défauts déjà adaptés en dev
# local (voir shared/config.py). Décommenter pour surcharger.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800

# Clé de signature JWT. En dev, une valeur aléatoire locale suffit — au
# moins 32 caractères (recommandation RFC 7518 §3.2 pour HMAC-SHA256).
# En prod : jamais ici, gérée par Secret Manager (agents.md §7).
JWT_SIGNING_KEY=dev-secret-change-me-please-1234567890

# Durées de vie des jetons (C4). Optionnelles : défauts déjà adaptés en dev
# local (voir shared/config.py). Décommenter pour surcharger.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Clé API Anthropic (Claude), fournisseur retenu pour E1/E2 (backlog.md).
# Laisser vide pour rester sur l'adaptateur factice en dev local (aucun coût
# API) ; renseigner une vraie clé pour activer la génération réelle
# (texte via Claude + image via template, voir adaptateur_claude.py et
# composition/app.py).
LLM_API_KEY=

# Modèle Claude utilisé par l'adaptateur (E1). Optionnel : défaut déjà
# adapté au budget (voir shared/config.py). Décommenter pour surcharger.
# LLM_MODEL=claude-haiku-4-5

# Stockage des images générées (E5, backlog.md). Laisser vide pour rester
# sur l'adaptateur filesystem local (dev, écrit sur le volume Docker
# `images_data`, voir docker-compose.yml) ; renseigner une fois L4 fait
# (bucket GCS provisionné) pour activer l'adaptateur GCS en prod.
GCS_BUCKET_IMAGES=

# Dossier d'écriture de l'adaptateur filesystem local. Optionnel : défaut
# déjà adapté au docker-compose (voir shared/config.py). Décommenter pour
# surcharger.
# LOCAL_STORAGE_DIR=data/images

# URL depuis laquelle le navigateur atteint l'API — sert à construire l'URL
# publique d'une image stockée en local. Doit rester cohérent avec
# NEXT_PUBLIC_API_URL ci-dessous en dev.
API_PUBLIC_URL=http://localhost:8000

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:3000

# Niveau de log de l'API (DEBUG, INFO, WARNING, ERROR). Logs en JSON
# structuré avec correlation_id (agents.md §9).
LOG_LEVEL=INFO

# --- Frontend ---
# URL de l'API telle qu'accessible depuis le navigateur (pas le nom
# de service docker "api", qui n'est résolvable qu'entre containers).
NEXT_PUBLIC_API_URL=http://localhost:8000
