# Python / back
back/.venv/
back/__pycache__/
**/__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# images stockées par StockageImageFilesystem (E5, dev hors docker-compose) —
# en conteneur, isolées du bind mount par le volume Docker `images_data`,
# jamais un souci ; hors conteneur (run local direct), ce dossier peut
# apparaître dans l'arbre de travail sans jamais devoir être committé.
back/data/

# secrets locaux — ne jamais committer
.env
.env.local

# Terraform (infra/) — état, plans et cache locaux, jamais committés
# (peuvent contenir des valeurs sensibles). Le .terraform.lock.hcl, lui,
# EST committé (pins les versions de provider, comme un lockfile npm).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
